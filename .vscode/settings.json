{
  // Use the project virtual environment. VS Code's Python + Jupyter extensions
  // will run notebook cells against this interpreter WITHOUT you starting a
  // Jupyter server manually — the extension manages the kernel for you.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Notebook quality-of-life
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "notebook.output.textLineLimit": 60,
  "notebook.lineNumbers": "on",

  "files.exclude": {
    "**/__pycache__": true,
    "**/.ipynb_checkpoints": true
  }
}
